<script>
const SUPA_URL = 'https://lnfghtlrzoioaotamzvy.supabase.co';
const SUPA_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxuZmdodGxyem9pb2FvdGFtenZ5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzY3MDg5MTMsImV4cCI6MjA5MjI4NDkxM30.lNHckve8P--rp9axdwZ6v6zTl4LLnk-1xY_kJS3wfFo';

const TOTAL_STEPS = 13;
let currentStep = 1;
const answers = {};

// ── Seleção de opções ──
function selectOpt(field, el, value){
  const container = el.closest('.options');
  container.querySelectorAll('.opt').forEach(o=>o.classList.remove('selected'));
  el.classList.add('selected');
  answers[field] = value;
  // Auto-avança em 300ms para opções de múltipla escolha
  setTimeout(()=>{
    const step = el.closest('.step');
    const stepNum = parseInt(step.id.replace('step-',''));
    if(stepNum < TOTAL_STEPS) nextStep(stepNum);
    else submitForm();
  }, 350);
}

// ── Navegação ──
function nextStep(from){
  // Validar
  if(!validateStep(from)) return;
  // Coletar campo de texto se houver
  collectTextFields(from);
  // Avançar
  goToStep(from + 1);
}

function prevStep(from){
  goToStep(from - 1);
}

function goToStep(n){
  if(n < 1 || n > TOTAL_STEPS) return;
  document.getElementById('step-'+currentStep).classList.remove('active');
  currentStep = n;
  document.getElementById('step-'+n).classList.add('active');
  updateProgress();
  window.scrollTo({top:0,behavior:'smooth'});
}

function updateProgress(){
  const pct = Math.round(((currentStep-1)/TOTAL_STEPS)*100);
  document.getElementById('progressFill').style.width = pct+'%';
  document.getElementById('progressLabel').textContent = `Pergunta ${currentStep} de ${TOTAL_STEPS}`;
  document.getElementById('progressPct').textContent = pct+'%';
}

// ── Validação ──
function validateStep(n){
  const errEl = document.getElementById('err-'+n);
  let valid = true;

  if(n===1){ valid = (document.getElementById('f_nome')?.value.trim().length > 1); }
  else if(n===2){ valid = (document.getElementById('f_instagram')?.value.trim().length > 1); }
  else if(n===3){ valid = (document.getElementById('f_whatsapp')?.value.trim().length > 7); }
  else if(n===4){ valid = !!answers.segmento; }
  else if(n===5){ valid = !!answers.tempo; }
  else if(n===6){ valid = !!answers.faturamento; }
  else if(n===7){ valid = (document.getElementById('f_meta')?.value.trim().length > 0); }
  else if(n===8){ valid = !!answers.desafio; }
  else if(n===9){ valid = (document.getElementById('f_impedimento')?.value.trim().length > 10); }
  else if(n===10){ valid = !!answers.situacao; }
  else if(n===11){ valid = (document.getElementById('f_visao')?.value.trim().length > 10); }
  else if(n===12){ valid = !!answers.reuniao; }
  else if(n===13){ valid = !!answers.investimento; }

  if(errEl){ errEl.classList.toggle('show', !valid); }
  return valid;
}

function collectTextFields(n){
  if(n===1) answers.nome = document.getElementById('f_nome')?.value.trim()||'';
  if(n===2) answers.instagram = document.getElementById('f_instagram')?.value.trim()||'';
  if(n===3) answers.whatsapp = document.getElementById('f_whatsapp')?.value.trim()||'';
  if(n===7) answers.meta = document.getElementById('f_meta')?.value.trim()||'';
  if(n===9) answers.impedimento = document.getElementById('f_impedimento')?.value.trim()||'';
  if(n===11) answers.visao = document.getElementById('f_visao')?.value.trim()||'';
}

// ── Qualificação ──
function calcQualificacao(){
  const fat = answers.faturamento || '';
  const DESQUALIF = ['Até R$ 5 mil'];
  if(DESQUALIF.includes(fat)) return 'desqualificado';
  return 'qualificado';
}

function calcStatusInicial(qualif){
  if(qualif === 'desqualificado') return 'bv_desqualif';
  const reuniao = answers.reuniao || '';
  if(reuniao === 'Sim')    return 'bv_qualif';
  if(reuniao === 'Talvez') return 'bv_aguardando';
  if(reuniao === 'Não')    return 'bv_sem_interesse';
  return 'bv_qualif';
}

function normIg(ig){
  return 'https://instagram.com/' + ig.replace('@','').trim().toLowerCase();
}

function gerarId(p='x'){ return p+'_'+Date.now()+'_'+Math.random().toString(36).slice(2,7); }

// ── Submit ──
async function submitForm(){
  if(!validateStep(13)) return;
  collectTextFields(13);

  const btnSubmit = document.getElementById('btnSubmit');
  if(btnSubmit){ btnSubmit.disabled=true; btnSubmit.textContent='Enviando...'; }

  const qualificacao = calcQualificacao();
  const statusInicial = calcStatusInicial(qualificacao);
  const igLink = normIg(answers.instagram||'');
  const hoje = new Date().toISOString().split('T')[0];

  try{
    // 1. Verificar se pessoa já existe (por WA ou IG)
    const waClean = (answers.whatsapp||'').replace(/\D/g,'');
    const igClean = (answers.instagram||'').toLowerCase().replace('@','');
    let pessoaId = null;

    const rPes = await fetch(
      SUPA_URL+'/rest/v1/crm_pessoas?or=(whatsapp.eq.'+encodeURIComponent(answers.whatsapp||'')+',instagram.eq.'+encodeURIComponent(answers.instagram||'')+')',
      {headers:{'apikey':SUPA_KEY,'Authorization':'Bearer '+SUPA_KEY}}
    );
    const pessoasExist = rPes.ok ? await rPes.json() : [];
    // Filtrar por WA limpo ou IG limpo
    const pessoaDup = pessoasExist.find(p=>{
      const pwa=(p.whatsapp||'').replace(/\D/g,'');
      const pig=(p.instagram||'').toLowerCase().replace('@','');
      return (waClean&&pwa&&pwa===waClean)||(igClean&&pig&&pig===igClean);
    });

    if(pessoaDup){
      pessoaId = pessoaDup.id;
      // Atualizar dados da pessoa
      await fetch(SUPA_URL+'/rest/v1/crm_pessoas?id=eq.'+pessoaId,{
        method:'PATCH',
        headers:{'apikey':SUPA_KEY,'Authorization':'Bearer '+SUPA_KEY,'Content-Type':'application/json','Prefer':'return=minimal'},
        body:JSON.stringify({nome:answers.nome,whatsapp:answers.whatsapp,instagram:igLink})
      });
    } else {
      pessoaId = gerarId('p');
      await fetch(SUPA_URL+'/rest/v1/crm_pessoas',{
        method:'POST',
        headers:{'apikey':SUPA_KEY,'Authorization':'Bearer '+SUPA_KEY,'Content-Type':'application/json','Prefer':'return=minimal'},
        body:JSON.stringify({id:pessoaId,nome:answers.nome,whatsapp:answers.whatsapp,instagram:igLink,email:''})
      });
    }

    // 2. Criar oportunidade no pipeline BV
    const opId = gerarId('op');
    const dadosOp = {
      id: opId,
      pessoa_id: pessoaId,
      pipeline: 'bv',
      funil: 'bv',
      origem: 'instagram',
      status: statusInicial,
      responsavel: 'Amanda',
      data_entrada: hoje,
      bv_segmento: answers.segmento||'',
      bv_tempo_op: answers.tempo||'',
      bv_faturamento: answers.faturamento||'',
      bv_meta_fat: answers.meta||'',
      bv_desafio: answers.desafio||'',
      bv_impedimento: answers.impedimento||'',
      bv_situacao: answers.situacao||'',
      bv_visao_6m: answers.visao||'',
      bv_interesse_reuniao: answers.reuniao||'',
      bv_interesse_invest: answers.investimento||'',
      bv_qualificacao: qualificacao,
    };

    await fetch(SUPA_URL+'/rest/v1/crm_oportunidades',{
      method:'POST',
      headers:{'apikey':SUPA_KEY,'Authorization':'Bearer '+SUPA_KEY,'Content-Type':'application/json','Prefer':'return=minimal'},
      body:JSON.stringify(dadosOp)
    });

    // 3. Salvar respostas brutas na tabela formulários
    const formId = gerarId('form');
    await fetch(SUPA_URL+'/rest/v1/crm_formularios',{
      method:'POST',
      headers:{'apikey':SUPA_KEY,'Authorization':'Bearer '+SUPA_KEY,'Content-Type':'application/json','Prefer':'return=minimal'},
      body:JSON.stringify({
        id:formId, tipo:'bv', pessoa_id:pessoaId, oportunidade_id:opId,
        respostas:answers, qualificacao, score:0
      })
    });

    // 4. Registrar evento no histórico
    await fetch(SUPA_URL+'/rest/v1/crm_eventos',{
      method:'POST',
      headers:{'apikey':SUPA_KEY,'Authorization':'Bearer '+SUPA_KEY,'Content-Type':'application/json','Prefer':'return=minimal'},
      body:JSON.stringify({
        id:gerarId('ev'), oportunidade_id:opId, pessoa_id:pessoaId,
        tipo:'criacao',
        descricao:`Formulário BV respondido · ${qualificacao === 'qualificado' ? '✓ Qualificado' : '✗ Desqualificado'} · Fat: ${answers.faturamento}`,
        status_anterior:'', status_novo:statusInicial, responsavel:''
      })
    });

    // Mostrar tela de sucesso
    document.getElementById('step-'+currentStep).classList.remove('active');
    document.getElementById('progressWrap').style.display='none';
    document.getElementById('formFooter').style.display='none';
    document.getElementById('successScreen').classList.add('show');

  }catch(e){
    console.error('Erro ao enviar formulário:', e);
    if(btnSubmit){ btnSubmit.disabled=false; btnSubmit.textContent='Enviar análise ✓'; }
    alert('Ocorreu um erro ao enviar. Por favor, tente novamente.');
  }
}
</script>
